# ==============================================
# Qdrant Configuration
# ==============================================
# Your Qdrant cloud URL (or localhost if running locally)
QDRANT_URL=your_qdrant_url_here
# Your Qdrant API key
QDRANT_API_KEY=your_qdrant_api_key_here

# Optional: Override collection names (defaults are set in code)
# PAPERS_COLLECTION=papers_semantic_v1
# PDF_VECTORS_COLLECTION=pdf_vectors

# ==============================================
# AI/LLM API Keys
# ==============================================
# Groq API key for LLM inference
GROQ_API_KEY=your_groq_api_key_here

# ==============================================
# Other Configuration
# ==============================================
# Add any other environment variables your app needs
